<Window x:Class="BlankUpper.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Blank Upper" Width="900" Height="590" MinWidth="700" MinHeight="480" Background="{StaticResource Bg}" Foreground="White" WindowStartupLocation="CenterScreen">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#171925" BorderBrush="#292C3D" BorderThickness="0,0,1,0"><DockPanel Margin="16">
   <StackPanel DockPanel.Dock="Top"><TextBlock Text="BLANK UPPER" FontWeight="Bold" FontSize="18" Foreground="{StaticResource Accent}" Margin="10,12,10,30"/>
    <Button Content="Home" Click="Home_Click"/><Button Content="Settings" Click="Settings_Click"/><Button Content="Developer" Click="Developer_Click"/>
   </StackPanel><TextBlock DockPanel.Dock="Bottom" Text="Runs quietly in your tray" Foreground="{StaticResource Muted}" Margin="10" TextWrapping="Wrap"/>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="42,34"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="HomePage"><StackPanel><TextBlock Text="Blank Upper" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="A small, thoughtful shortcut for File Explorer." Foreground="{StaticResource Muted}" FontSize="16" Margin="0,7,0,28"/>
    <Border Background="{StaticResource Card}" CornerRadius="16" Padding="25"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Enable Blank Upper" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Margin="0,6,0,0" Foreground="{StaticResource Muted}"/></StackPanel><ToggleButton x:Name="EnabledToggle" Grid.Column="1" Style="{StaticResource Toggle}" Checked="EnabledChanged" Unchecked="EnabledChanged" AutomationProperties.Name="Enable Blank Upper"/></Grid></Border>
    <Border Background="#25213A" CornerRadius="14" Padding="22" Margin="0,20,0,0"><TextBlock Text="Double-click blank space in File Explorer to go to the parent folder." FontSize="16" TextWrapping="Wrap"/></Border>
   </StackPanel></Grid>
   <Grid x:Name="SettingsPage" Visibility="Collapsed"><StackPanel><TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,25"/><Border Background="{StaticResource Card}" CornerRadius="16" Padding="22"><StackPanel>
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Start with Windows" FontSize="17"/><TextBlock Text="Launches in the background for this user." Foreground="{StaticResource Muted}"/></StackPanel><ToggleButton x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource Toggle}" Checked="StartupChanged" Unchecked="StartupChanged" AutomationProperties.Name="Start with Windows"/></Grid>
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Run minimized" FontSize="17"/><TextBlock Text="Hide to the tray when launched normally." Foreground="{StaticResource Muted}"/></StackPanel><ToggleButton x:Name="MinimizedToggle" Grid.Column="1" Style="{StaticResource Toggle}" Checked="MinimizedChanged" Unchecked="MinimizedChanged" AutomationProperties.Name="Run minimized"/></Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Show notification when activated" FontSize="17"/><TextBlock Text="Shows a brief tray notification after navigation." Foreground="{StaticResource Muted}"/></StackPanel><ToggleButton x:Name="NotificationToggle" Grid.Column="1" Style="{StaticResource Toggle}" Checked="NotificationChanged" Unchecked="NotificationChanged" AutomationProperties.Name="Show notification when activated"/></Grid>
   </StackPanel></Border></StackPanel></Grid>
   <Grid x:Name="DeveloperPage" Visibility="Collapsed"><StackPanel><TextBlock Text="Developer" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,25"/><Border Background="{StaticResource Card}" CornerRadius="16" Padding="25"><StackPanel><TextBlock Text="Developed by Jeevan Varghese" FontSize="19" FontWeight="SemiBold"/><TextBlock Margin="0,16,0,4">Website</TextBlock><TextBlock><Hyperlink NavigateUri="https://itsjeevanvarghese.web.app" RequestNavigate="Website_RequestNavigate" Foreground="{StaticResource Accent}">https://itsjeevanvarghese.web.app</Hyperlink></TextBlock><TextBlock x:Name="VersionText" Margin="0,25,0,0" Foreground="{StaticResource Muted}"/></StackPanel></Border></StackPanel></Grid>
   <TextBlock Grid.Row="1" Text="Blank Upper - Background Explorer helper" Foreground="#777B94" Margin="0,20,0,0"/>
  </Grid>
 </Grid>
</Window>
