<Window x:Class="MomentumScroll.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Momentum Scroll Settings" Width="620" Height="690" WindowStartupLocation="CenterOwner" Background="#FF171B23" Foreground="#FFF2F5FA"><Window.Resources><Style TargetType="GroupBox"><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Padding" Value="14"/><Setter Property="Background" Value="#FF222A35"/></Style><Style TargetType="Slider"><Setter Property="Margin" Value="0,2,0,10"/></Style></Window.Resources><DockPanel Margin="22"><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Restore Defaults" Click="Restore_Click"/><Button Content="Close" Click="Close_Click"/></StackPanel><ScrollViewer><StackPanel><TextBlock Text="Settings" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Changes apply instantly and save automatically." Foreground="#FF9EAEBD" Margin="0,4,0,18"/><GroupBox Header="Momentum"><StackPanel><TextBlock Text="Activation sensitivity"/><Slider Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ActivationSensitivity, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Minimum flick notches"/><Slider Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MinimumFlickNotches, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Flick detection window (ms)"/><Slider Minimum="100" Maximum="800" Value="{Binding FlickDetectionWindowMs, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Momentum strength"/><Slider Minimum="0.25" Maximum="3" Value="{Binding MomentumStrength, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Friction / deceleration"/><Slider Minimum="0.80" Maximum="0.995" Value="{Binding FrictionPerTick, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Maximum scroll speed"/><Slider Minimum="300" Maximum="5000" Value="{Binding MaximumVelocity, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Minimum stop velocity"/><Slider Minimum="5" Maximum="200" Value="{Binding MinimumStopVelocity, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></GroupBox><GroupBox Header="Behaviour"><WrapPanel><CheckBox Content="Same direction boost" IsChecked="{Binding SameDirectionBoosts}" Margin="8"/><CheckBox Content="Opposite direction stops momentum" IsChecked="{Binding OppositeDirectionStops}" Margin="8"/><CheckBox Content="Natural scrolling" IsChecked="{Binding NaturalScrolling}" Margin="8"/><CheckBox Content="Horizontal scroll support" IsChecked="{Binding HorizontalScrolling}" Margin="8"/></WrapPanel></GroupBox><GroupBox Header="Application"><StackPanel><CheckBox Content="Master Enable" IsChecked="{Binding IsEnabled}" Margin="8"/><CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="8"/><CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}" Margin="8"/><CheckBox Content="Minimize to tray" IsChecked="{Binding MinimizeToTray}" Margin="8"/><TextBlock Text="Theme"/><ComboBox SelectedValue="{Binding Theme}" SelectedValuePath="Content"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox></StackPanel></GroupBox></StackPanel></ScrollViewer></DockPanel></Window>
