<Window x:Class="MomentumScroll.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Momentum Scroll" Height="500" Width="490" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Icon="Resources/MomentumScroll.ico" Background="#FF171B23" Foreground="#FFF2F5FA">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Momentum Scroll" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Fast wheel flicks, smooth natural momentum." Foreground="#FF9EAEBD" Margin="0,5,0,20"/></StackPanel>
    <Border Grid.Row="1" Background="#FF222A35" CornerRadius="10" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Master control" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Foreground="#FF57B8FF" Margin="0,3,0,0"/></StackPanel><CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Content="Enabled"/></Grid></Border>
    <StackPanel Grid.Row="2" Margin="0,20,0,0"><TextBlock Text="LIVE STATUS" Foreground="#FF9EAEBD" FontSize="11"/><UniformGrid Columns="2" Margin="0,8,0,0"><StackPanel Margin="0,4"><TextBlock Text="Hook" Foreground="#FF9EAEBD"/><TextBlock Text="{Binding HookStatus}"/></StackPanel><StackPanel Margin="0,4"><TextBlock Text="Physical direction" Foreground="#FF9EAEBD"/><TextBlock Text="{Binding Direction}"/></StackPanel><StackPanel Margin="0,4"><TextBlock Text="Velocity" Foreground="#FF9EAEBD"/><TextBlock Text="{Binding Velocity}"/></StackPanel><StackPanel Margin="0,4"><TextBlock Text="Momentum" Foreground="#FF9EAEBD"/><TextBlock Text="{Binding MomentumStatus}"/></StackPanel><StackPanel Margin="0,4"><TextBlock Text="Last injected" Foreground="#FF9EAEBD"/><TextBlock Text="{Binding LastInjected}"/></StackPanel></UniformGrid><Expander Header="Diagnostics" IsExpanded="{Binding DiagnosticsVisible, Mode=TwoWay}" Margin="0,12,0,0"><TextBlock Text="{Binding Diagnostics}" FontFamily="Consolas" FontSize="11" Foreground="#FFB9C6D4" Margin="5,8"/></Expander></StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Settings" Click="Settings_Click"/><Button Content="Restore Defaults" Click="RestoreDefaults_Click"/><Button Content="About" Click="About_Click"/><Button Content="Exit" Click="Exit_Click"/></StackPanel>
  </Grid>
</Window>
