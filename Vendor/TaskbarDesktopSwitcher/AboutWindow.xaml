<Window x:Class="TaskbarDesktopSwitcher.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskbarDesktopSwitcher"
        mc:Ignorable="d"
        Title="About - Taskbar Desktop Switcher"
        Height="500"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#F5F5F5">
    <Grid Margin="40,30,40,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- App Icon/Logo Area -->
        <Border Grid.Row="0"
                Width="80"
                Height="80"
                Background="#0078D4"
                CornerRadius="8"
                HorizontalAlignment="Center"
                Margin="0,0,0,20">
            <TextBlock Text="TDS"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- App Name -->
        <TextBlock Grid.Row="1"
                   Text="Taskbar Desktop Switcher"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#1A1A1A"
                   HorizontalAlignment="Center"/>

        <!-- Version -->
        <TextBlock Grid.Row="2"
                    Text="Version 2.0.0"
                    FontSize="14"
                    Foreground="#666666"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,20"/>

        <!-- Description -->
        <TextBlock Grid.Row="3"
                   Text="A lightweight utility for Windows 11 that enables virtual desktop switching by scrolling the mouse wheel over the taskbar."
                   FontSize="12"
                   Foreground="#555555"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   LineHeight="18"
                   Margin="0,0,0,20"/>

        <!-- Developer Info -->
        <Border Grid.Row="4"
                Background="White"
                CornerRadius="8"
                Padding="20,15,20,15"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Developed by"
                           FontSize="12"
                           Foreground="#888888"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>
                <TextBlock Text="Jeevan Varghese"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#1A1A1A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>
                <TextBlock Text="jeevanvarghese579@gmail.com"
                           FontSize="12"
                           Foreground="#0078D4"
                           HorizontalAlignment="Center"
                           Cursor="Hand"
                           MouseDown="Email_MouseDown"
                           Margin="0,0,0,10"/>
                <TextBlock Text="Copyright © 2026 Jeevan Varghese"
                           FontSize="11"
                           Foreground="#888888"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Close Button -->
        <Button Grid.Row="5"
                Content="Close"
                Width="100"
                Height="35"
                HorizontalAlignment="Center"
                Margin="0,20,0,0"
                Background="#0078D4"
                Foreground="White"
                BorderThickness="0"
                FontSize="14"
                FontWeight="SemiBold"
                Click="CloseButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        BorderBrush="{TemplateBinding BorderBrush}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#106EBE"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#005A9E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

    </Grid>
</Window>
