<Window x:Class="TaskbarDesktopSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskbarDesktopSwitcher"
        mc:Ignorable="d"
        Title="Taskbar Desktop Switcher"
        Height="720"
        Width="550"
        MinHeight="500"
        MinWidth="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Loaded="Window_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="60">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- App Title and About Button -->
        <Grid Grid.Row="0" Margin="0,0,0,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Grid Grid.Column="0" VerticalAlignment="Top" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="Taskbar Desktop Switcher"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#1A1A1A"
                           TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1"
                           Text="Configure actions for the top and bottom screen edges"
                           FontSize="14"
                           Foreground="#666666"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"/>
            </Grid>
            
            <Button x:Name="AboutButton"
                    Grid.Column="1"
                    Content="About"
                    VerticalAlignment="Top"
                    Margin="10,8,0,0"
                    Width="80"
                    Height="30"
                    Background="Transparent"
                    Foreground="#0078D4"
                    BorderThickness="1"
                    BorderBrush="#0078D4"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Click="AboutButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            BorderBrush="{TemplateBinding BorderBrush}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E6F3FF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#CCE4FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Status Indicator -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="StatusIndicator"
                         Width="12"
                         Height="12"
                         Fill="#4CAF50"
                         VerticalAlignment="Center"
                         Margin="0,0,15,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Status"
                               FontSize="12"
                               Foreground="#999999"/>
                    <TextBlock x:Name="StatusText"
                               Text="Running"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#1A1A1A"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Enable/Disable Toggle -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Enable Desktop Switcher"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#1A1A1A"/>
                    <TextBlock Text="Turn the mouse wheel desktop switching on or off"
                               FontSize="12"
                               Foreground="#999999"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <ToggleButton x:Name="EnableSwitcherToggle"
                              Grid.Column="1"
                              Width="50"
                              Height="26"
                              Checked="EnableSwitcherToggle_Checked"
                              Unchecked="EnableSwitcherToggle_Unchecked">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="#CCCCCC"
                                                CornerRadius="13"
                                                Width="50"
                                                Height="26">
                                            <Ellipse x:Name="Ellipse"
                                                     Fill="White"
                                                     Width="20"
                                                     Height="20"
                                                     HorizontalAlignment="Left"
                                                     Margin="3,0,0,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#4CAF50"/>
                                                <Setter TargetName="Ellipse" Property="HorizontalAlignment" Value="Right"/>
                                                <Setter TargetName="Ellipse" Property="Margin" Value="0,0,3,0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- Edge actions -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,30">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Top Edge" FontSize="16" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                    <TextBlock Text="Choose what the wheel does at the top of each monitor" FontSize="12" Foreground="#999999" Margin="0,2,0,0"/>
                </StackPanel>
                <ComboBox x:Name="TopEdgeComboBox" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="EdgeComboBox_SelectionChanged">
                    <ComboBoxItem Tag="None" Content="None"/>
                    <ComboBoxItem Tag="VirtualDesktops" Content="Virtual Desktops"/>
                    <ComboBoxItem Tag="WindowSwitching" Content="Window Switching"/>
                </ComboBox>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,30">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Bottom Edge" FontSize="16" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                    <TextBlock Text="Choose what the wheel does at the bottom of each monitor" FontSize="12" Foreground="#999999" Margin="0,2,0,0"/>
                </StackPanel>
                <ComboBox x:Name="BottomEdgeComboBox" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="EdgeComboBox_SelectionChanged">
                    <ComboBoxItem Tag="None" Content="None"/>
                    <ComboBoxItem Tag="VirtualDesktops" Content="Virtual Desktops"/>
                    <ComboBoxItem Tag="WindowSwitching" Content="Window Switching"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- Window Switcher selection button -->
        <Border Grid.Row="5" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,30">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Window Switcher Select Button" FontSize="16" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                    <TextBlock Text="Button used to activate the highlighted application" FontSize="12" Foreground="#999999" Margin="0,2,0,0"/>
                </StackPanel>
                <ComboBox x:Name="WindowSwitcherSelectButtonComboBox" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="WindowSwitcherSelectButtonComboBox_SelectionChanged">
                    <ComboBoxItem Tag="Left" Content="Left Mouse Button"/>
                    <ComboBoxItem Tag="Right" Content="Right Mouse Button"/>
                    <ComboBoxItem Tag="Middle" Content="Middle Mouse Button"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- Start with Windows Toggle -->
        <Border Grid.Row="6"
                Background="White"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Start with Windows"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#1A1A1A"/>
                    <TextBlock Text="Automatically start the app when you log in"
                               FontSize="12"
                               Foreground="#999999"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <ToggleButton x:Name="StartWithWindowsToggle"
                              Grid.Column="1"
                              Width="50"
                              Height="26"
                              Checked="StartWithWindowsToggle_Checked"
                              Unchecked="StartWithWindowsToggle_Unchecked">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="#CCCCCC"
                                                CornerRadius="13"
                                                Width="50"
                                                Height="26">
                                            <Ellipse x:Name="Ellipse"
                                                     Fill="White"
                                                     Width="20"
                                                     Height="20"
                                                     HorizontalAlignment="Left"
                                                     Margin="3,0,0,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#4CAF50"/>
                                                <Setter TargetName="Ellipse" Property="HorizontalAlignment" Value="Right"/>
                                                <Setter TargetName="Ellipse" Property="Margin" Value="0,0,3,0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- Start Minimized to Tray Toggle -->
        <Border Grid.Row="7"
                Background="White"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Start Minimized to Tray"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#1A1A1A"/>
                    <TextBlock Text="Application will start minimized to system tray"
                               FontSize="12"
                               Foreground="#999999"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <ToggleButton x:Name="StartMinimizedToggle"
                              Grid.Column="1"
                              Width="50"
                              Height="26"
                              Checked="StartMinimizedToggle_Checked"
                              Unchecked="StartMinimizedToggle_Unchecked">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="#CCCCCC"
                                                CornerRadius="13"
                                                Width="50"
                                                Height="26">
                                            <Ellipse x:Name="Ellipse"
                                                     Fill="White"
                                                     Width="20"
                                                     Height="20"
                                                     HorizontalAlignment="Left"
                                                     Margin="3,0,0,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#4CAF50"/>
                                                <Setter TargetName="Ellipse" Property="HorizontalAlignment" Value="Right"/>
                                                <Setter TargetName="Ellipse" Property="Margin" Value="0,0,3,0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </Grid>
        </Border>

    </Grid>
    </ScrollViewer>
</Window>
