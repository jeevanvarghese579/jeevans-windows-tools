<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>JeevansWindowsTools</AssemblyName>
    <RootNamespace>JeevansWindowsTools</RootNamespace>
    <ApplicationIcon>Assets\JeevansWindowsTools.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Company>Jeevan Varghese</Company>
    <Authors>Jeevan Varghese</Authors>
    <Product>Jeevan's Windows Tools</Product>
    <Description>Transparent Windows productivity utilities for Explorer, scrolling, and desktop switching.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DefaultItemExcludes>$(DefaultItemExcludes);Taskbar-Windows-Switcher\**;Vendor\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="Vendor\BlankUpper\BlankUpper.csproj" />
    <ProjectReference Include="Vendor\MomentumScroll\MomentumScroll.App\MomentumScroll.App.csproj" />
    <ProjectReference Include="Vendor\TaskbarDesktopSwitcher\TaskbarDesktopSwitcher.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\JeevansWindowsTools.ico" />
    <Content Include="Assets\JeevansWindowsTools.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
